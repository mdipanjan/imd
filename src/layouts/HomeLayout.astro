---
import BaseLayout from './BaseLayout.astro';

type Props = {
  description: string;
};

const { description } = Astro.props;
---

<BaseLayout description={description} mainClass="home-page">
  <div class="journal-home">
    <slot />
  </div>
</BaseLayout>

<style>
  :global(main.home-page) {
    padding: clamp(3rem, 5vw, 4.8rem) 0;
    border-inline: 0;
  }

  .journal-home {
    --home-edge-inset: var(--space-5);

    width: min(90rem, 100%);
    margin-inline: auto;
  }
</style>
