---
import type { PostLink, PostView } from '../lib/post-view';
import AnnotationRail from '../components/article/AnnotationRail.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ArticleIndexRail from '../components/article/ArticleIndexRail.astro';
import CodeBlocks from '../components/article/CodeBlocks.astro';
import PostNavigation from '../components/PostNavigation.astro';
import BaseLayout from './BaseLayout.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  post: PostView;
  headings?: Heading[];
  previous?: PostLink;
  next?: PostLink;
};

const { post, headings = [], previous, next } = Astro.props;
const annotations = post.annotations;
const hasAnnotations = annotations.length > 0;
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.updated}
  tags={post.tags}
  mainClass="article-page"
>
  <article class:list={{ 'article-layout': true, 'article-layout--annotated': hasAnnotations }}>
    <ArticleIndexRail headings={headings} variant="rail" />
    <div class="article-reading">
      <ArticleHeader
        title={post.title}
        description={post.description}
        date={post.date}
        updated={post.updated}
        tags={post.tags}
      />
      <ArticleIndexRail headings={headings} variant="disclosure" />
      <div class="article-prose">
        <slot />
      </div>
      <CodeBlocks />
      <PostNavigation previous={previous} next={next} />
    </div>
    {hasAnnotations && <AnnotationRail annotations={annotations} />}
  </article>
</BaseLayout>

<style>
  :global(main.article-page) {
    width: 100%;
    max-width: none;
    padding: 0;
    border-inline: 0;
    background: var(--color-page);
  }

  .article-layout {
    display: grid;
    width: min(var(--width-site), 100%);
    min-height: 100vh;
    margin-inline: auto;
    grid-template-columns: var(--width-index-rail) minmax(0, 1fr);
    border-inline: var(--border-thin) solid var(--color-rule);
    background: var(--color-surface);
  }

  .article-layout--annotated {
    grid-template-columns:
      var(--width-index-rail) minmax(0, 1fr)
      var(--width-annotation-rail);
  }

  .article-reading {
    min-width: 0;
    padding: var(--space-7) clamp(var(--space-6), 5vw, var(--space-8)) var(--space-8);
  }

  :global(.article-prose) {
    max-width: var(--width-prose);
    margin: var(--space-7) auto 0;
    font-size: 0.98rem;
    line-height: 1.8;
  }

  :global(.article-prose h2) {
    margin: var(--space-8) 0 var(--space-4);
    font-size: 1.4rem;
    font-weight: var(--weight-regular);
  }

  :global(.article-prose h3) {
    margin-top: var(--space-7);
    font-size: 1.15rem;
    font-weight: var(--weight-medium);
  }

  :global(.article-prose :is(h2, h3)) {
    scroll-margin-top: var(--space-6);
  }

  :global(.article-prose blockquote) {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: var(--border-emphasis) solid var(--color-revision);
    color: var(--color-text-muted);
    font-size: 1.03rem;
    font-style: italic;
  }

  :global(.article-prose img) {
    max-width: 100%;
    height: auto;
  }

  :global(.article-prose code) {
    padding: 0.1rem 0.3rem;
    background: var(--color-code-surface);
    font-family: var(--font-code);
    font-size: 0.86em;
  }

  :global(.article-prose pre) {
    overflow-x: auto;
    margin-block: var(--space-6);
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-rule);
    background: var(--color-code-surface);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  :global(.article-prose pre code) {
    padding: 0;
    background: transparent;
  }

  :global(.annotation-trigger) {
    padding: 0;
    border: 0;
    border-bottom: var(--border-thin) dotted currentColor;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: help;
  }

  :global(.annotation-trigger sup) {
    margin-left: 0.12em;
    color: var(--color-accent);
    font-family: var(--font-interface);
    font-size: 0.58em;
    font-style: normal;
  }

  :global(.annotation-trigger:hover),
  :global(.annotation-trigger:focus-visible),
  :global(.annotation-trigger[aria-expanded='true']) {
    color: var(--color-accent);
  }

  :global(.annotation-trigger:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 1180px) {
    .article-layout,
    .article-layout--annotated {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .article-layout {
      display: block;
      width: 100%;
      border-inline: 0;
    }

    .article-reading {
      padding: var(--space-7) clamp(var(--space-5), 6vw, var(--space-7)) var(--space-8);
    }
  }

  @media (max-width: 620px) {
    .article-reading {
      padding-inline: var(--page-gutter);
    }
  }
</style>

<script>
  const triggers = [...document.querySelectorAll<HTMLElement>('[data-annotation-trigger]')];
  const notes = [...document.querySelectorAll<HTMLElement>('[data-annotation-note]')];
  const rail = document.querySelector<HTMLElement>('.annotation-rail');
  let pinnedAnnotation: string | null = null;

  const showAnnotation = (id: string | null) => {
    const activeTrigger = triggers.find((trigger) => trigger.dataset.annotationTrigger === id);
    if (rail && activeTrigger) {
      const railTop = rail.getBoundingClientRect().top;
      const triggerTop = activeTrigger.getBoundingClientRect().top;
      rail.style.setProperty('--annotation-top', `${Math.max(32, triggerTop - railTop)}px`);
    }
    triggers.forEach((trigger) => {
      trigger.setAttribute('aria-expanded', String(trigger.dataset.annotationTrigger === id));
    });
    notes.forEach((note) => {
      note.classList.toggle('is-active', note.dataset.annotationNote === id);
    });
    rail?.classList.toggle('has-active', id !== null);
  };

  triggers.forEach((trigger) => {
    const id = trigger.dataset.annotationTrigger ?? null;

    trigger.addEventListener('mouseenter', () => {
      if (!pinnedAnnotation) showAnnotation(id);
    });
    trigger.addEventListener('mouseleave', () => {
      if (!pinnedAnnotation && document.activeElement !== trigger) showAnnotation(null);
    });
    trigger.addEventListener('focusin', () => showAnnotation(id));
    trigger.addEventListener('focusout', () => {
      if (!pinnedAnnotation) showAnnotation(null);
    });
    trigger.addEventListener('click', () => {
      pinnedAnnotation = pinnedAnnotation === id ? null : id;
      showAnnotation(pinnedAnnotation);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      pinnedAnnotation = null;
      showAnnotation(null);
    }
  });
</script>
