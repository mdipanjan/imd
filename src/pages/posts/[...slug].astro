---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { toPostLink, toPostView } from '../../lib/post-view';
import { selectPosts } from '../../lib/posts.mjs';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = selectPosts(await getCollection('posts'), { includeDrafts });

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      next: posts[index - 1],
      previous: posts[index + 1],
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const article = toPostView(post);
---

<ArticleLayout
  post={article}
  headings={headings}
  previous={toPostLink(previous)}
  next={toPostLink(next)}
>
  <Content />
</ArticleLayout>
