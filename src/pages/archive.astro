---
import { getCollection } from 'astro:content';
import ArchiveIndex from '../components/archive/ArchiveIndex.astro';
import InteriorPageLayout from '../layouts/InteriorPageLayout.astro';
import { toPostView } from '../lib/post-view';
import { selectPosts } from '../lib/posts.mjs';

const posts = selectPosts(await getCollection('posts'));

const postViews = posts.map(toPostView);
const years = [...new Set(postViews.map((post) => post.date.getFullYear()))];
const yearRange = years.length > 1 ? `${years.at(-1)}–${years[0]}` : String(years[0] ?? '—');
---

<InteriorPageLayout
  title="Archive"
  description="Every published field note, grouped by year."
  eyebrow="Journal index"
  lede="Every published note in one quiet chronology—first attempts, later revisions, and the ideas that survived both."
  rail={{
    title: 'At a glance',
    items: [
      { label: 'Published', value: String(postViews.length).padStart(2, '0') },
      { label: 'Years', value: yearRange },
      { label: 'Order', value: 'Newest first' },
    ],
    note: 'The archive grows when a note is useful enough to keep.',
  }}
>
  <ArchiveIndex posts={postViews} />
</InteriorPageLayout>
