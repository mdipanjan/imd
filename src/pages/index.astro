---
import { getCollection } from 'astro:content';
import FeaturedPost from '../components/home/FeaturedPost.astro';
import HomeIntroduction from '../components/home/HomeIntroduction.astro';
import PostIndex from '../components/home/PostIndex.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
import { toPostView } from '../lib/post-view';
import { POSTS_PER_PAGE, selectPosts } from '../lib/posts.mjs';
import { site } from '../lib/site';

const includeDrafts = import.meta.env.DEV;

const posts = selectPosts(await getCollection('posts'), { includeDrafts });
const postViews = posts.map(toPostView);
---

<HomeLayout description={site.description}>
  <HomeIntroduction />
  <div class="journal-feed">
    <FeaturedPost post={postViews[0]} />
    {
      postViews.length > 1 && (
        <PostIndex
          posts={postViews.slice(1, POSTS_PER_PAGE)}
          total={postViews.filter((post) => !post.draft).length}
        />
      )
    }
  </div>
</HomeLayout>

<style>
  .journal-feed {
    max-width: var(--width-prose);
    margin-left: var(--width-index-rail);
    padding: var(--space-7) var(--journal-edge-inset) var(--space-8) 0;
  }

  @media (max-width: 900px) {
    .journal-feed {
      margin-left: 0;
      padding-inline: var(--journal-edge-inset);
    }
  }
</style>
