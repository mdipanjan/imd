---
import { getCollection } from 'astro:content';
import CurrentFocus from '../components/home/CurrentFocus.astro';
import FeaturedPost from '../components/home/FeaturedPost.astro';
import HomeIntroduction from '../components/home/HomeIntroduction.astro';
import PostIndex from '../components/home/PostIndex.astro';
import HomeLayout from '../layouts/HomeLayout.astro';

const POSTS_PER_PAGE = 8;

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const currentFocus = [
  { label: 'Exploring', value: 'Memory and evaluation for agents' },
  { label: 'Building', value: 'Small tools that explain themselves' },
  { label: 'Learning', value: 'Distributed systems from failure reports' },
];
---

<HomeLayout description="A personal technical journal about software, systems, and changed ideas.">
  <HomeIntroduction />
  <div class="journal-body">
    <CurrentFocus items={currentFocus} />
    <div class="journal-feed">
      <FeaturedPost
        post={posts[0]}
        belief={{
          before: 'More structure makes publishing easier.',
          after: 'The smallest durable workflow wins.',
        }}
      />
      <PostIndex posts={posts.slice(1, POSTS_PER_PAGE)} total={posts.length} />
    </div>
  </div>
</HomeLayout>

<style>
  .journal-body {
    display: grid;
    grid-template-columns: var(--width-index-rail) minmax(0, 1fr);
  }

  .journal-feed {
    min-width: 0;
    padding: var(--space-7) 0 var(--space-8) clamp(var(--space-6), 4vw, var(--space-8));
    padding-right: var(--home-edge-inset);
    border-left: var(--border-thin) solid var(--color-rule);
  }

  @media (max-width: 800px) {
    .journal-body {
      grid-template-columns: 1fr;
    }

    .journal-feed {
      padding-inline: var(--home-edge-inset);
      border-left: 0;
    }
  }
</style>
