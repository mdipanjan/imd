---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import InteriorPageLayout from '../../layouts/InteriorPageLayout.astro';
import { toPostView } from '../../lib/post-view';

type PageProps = {
  page: {
    currentPage: number;
    lastPage: number;
    data: CollectionEntry<'posts'>[];
  };
};

export async function getStaticPaths() {
  const postsPerPage = 8;
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const lastPage = Math.ceil(posts.length / postsPerPage);
  const paths = [];

  for (let currentPage = 2; currentPage <= lastPage; currentPage += 1) {
    const start = (currentPage - 1) * postsPerPage;
    paths.push({
      params: { page: String(currentPage) },
      props: {
        page: {
          currentPage,
          lastPage,
          data: posts.slice(start, start + postsPerPage),
        },
      },
    });
  }

  return paths;
}

const { page } = Astro.props as PageProps;
const postViews = page.data.map(toPostView);
---

<InteriorPageLayout
  title="Earlier notes"
  description={`Earlier field notes, page ${page.currentPage}.`}
  eyebrow="Journal index"
  lede="Older entries from the same working record, kept in reverse chronological order."
  rail={{
    title: 'This page',
    items: [
      { label: 'Page', value: `${page.currentPage} of ${page.lastPage}` },
      { label: 'Showing', value: `${postViews.length} notes` },
      { label: 'Order', value: 'Newest first' },
    ],
  }}
>
  <PostList posts={postViews} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} />
</InteriorPageLayout>
