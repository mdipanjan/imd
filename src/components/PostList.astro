---
import { formatShortDate, formatTaxonomy } from '../lib/format';
import type { PostView } from '../lib/post-view';

type Props = {
  posts: PostView[];
};

const { posts } = Astro.props;
---

<div class="post-list">
  {
    posts.map((post, index) => (
      <article class="post-item">
        <span class="post-item__index" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="post-item__body">
          <div class="post-meta">
            <time datetime={post.date.toISOString()}>{formatShortDate(post.date, true)}</time>
            {post.tags.map(formatTaxonomy).map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
          <h2>
            <a href={post.href}>{post.title}</a>
          </h2>
          <p>{post.description}</p>
        </div>
        <span class="post-item__arrow" aria-hidden="true">
          ↗
        </span>
      </article>
    ))
  }
</div>
