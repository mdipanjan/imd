---
import type { PostLink } from '../lib/post-view';

type Props = {
  previous?: PostLink;
  next?: PostLink;
};

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="post-navigation" aria-label="Adjacent posts">
      <div>
        {next && (
          <a href={next.href} rel="next">
            <span>Newer</span>
            {next.title}
          </a>
        )}
      </div>
      <div>
        {previous && (
          <a href={previous.href} rel="prev">
            <span>Older</span>
            {previous.title}
          </a>
        )}
      </div>
    </nav>
  )
}
