---
import { formatShortDate, formatTaxonomy } from '../../lib/format';
import type { PostView } from '../../lib/post-view';

type Props = {
  post?: PostView;
};

const { post } = Astro.props;
---

{
  post && (
    <article class="featured-post">
      <div class="featured-post__copy">
        <p class="featured-post__label">
          {post.draft ? 'Draft preview' : 'Latest article'} ·{' '}
          {formatShortDate(post.draft ? (post.updated ?? post.date) : post.date, true)}
        </p>
        <h2>
          <a href={post.href}>{post.title}</a>
        </h2>
        <p>{post.description}</p>
      </div>
      <footer>
        <span class="featured-post__taxonomy">
          {post.tags.map(formatTaxonomy).join(' · ') || 'Field note'}
        </span>
        <span class="featured-post__state">
          {post.draft ? 'In progress' : post.updated ? 'Updated' : 'Published'}
        </span>
      </footer>
    </article>
  )
}

<style>
  .featured-post {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding-bottom: var(--space-7);
    border-bottom: var(--border-thin) solid var(--color-rule-strong);
  }

  .featured-post__label {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    letter-spacing: 0.06em;
  }

  h2 {
    max-width: 28ch;
    text-wrap: balance;
    margin: var(--space-3) 0 var(--space-4);
    font-size: clamp(1.7rem, 2.35vw, 2.5rem);
    font-weight: var(--weight-regular);
    letter-spacing: -0.035em;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  .featured-post__copy > p:last-child {
    max-width: 36rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: var(--line-height-reading);
  }

  footer {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    color: var(--color-accent);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 900px) {
    .featured-post {
      grid-template-columns: 1fr;
    }
  }
</style>
