---
import { formatShortDate } from '../../lib/format';
import type { PostView } from '../../lib/post-view';
import SectionHeading from '../journal/SectionHeading.astro';

type Props = {
  posts: PostView[];
  total: number;
};

const { posts, total } = Astro.props;
---

<section class="journal-index" aria-labelledby="recent-posts">
  <SectionHeading
    id="recent-posts"
    eyebrow="More writing"
    title="Recent notes"
    meta={`${String(total).padStart(2, '0')} published`}
  />
  {
    posts.length > 0 ? (
      <div class="journal-index__list">
        {posts.map((post) => (
          <a href={post.href}>
            <time datetime={post.date.toISOString()}>{formatShortDate(post.date)}</time>
            <strong>{post.title}</strong>
            <em>{post.tags[0] ?? 'Field note'}</em>
          </a>
        ))}
      </div>
    ) : (
      <p class="journal-index__empty">More notes will appear here as the journal grows.</p>
    )
  }
</section>

<style>
  .journal-index {
    margin-top: var(--space-8);
  }

  .journal-index__list a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 8rem;
    gap: var(--space-4);
    padding-block: 1.15rem;
    border-top: var(--border-thin) solid var(--color-rule);
    color: inherit;
    text-decoration: none;
  }

  .journal-index__list a:last-child {
    border-bottom: var(--border-thin) solid var(--color-rule);
  }

  time,
  em {
    color: var(--color-text-faint);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
  }

  em {
    text-align: right;
  }

  a:hover strong {
    color: var(--color-accent);
  }

  .journal-index__empty {
    margin: 0;
    padding-block: var(--space-5);
    border-block: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 560px) {
    .journal-index__list a {
      grid-template-columns: 4rem minmax(0, 1fr);
    }

    em {
      display: none;
    }
  }
</style>
