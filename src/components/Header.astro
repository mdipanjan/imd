---
import { getCollection } from 'astro:content';
import ReadingPreferences from './ReadingPreferences.astro';
import { postHref, selectPosts } from '../lib/posts.mjs';

type Props = {
  variant?: 'journal' | 'article';
};

const { variant = 'journal' } = Astro.props;
const isArticle = variant === 'article';
const includeDrafts = import.meta.env.DEV;

const latestPost = selectPosts(await getCollection('posts'), { includeDrafts })[0];

const sharedNav = [
  { href: '/', label: 'Index' },
  { href: latestPost ? postHref(latestPost) : '/archive/', label: 'Latest note' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-variant={variant}>
  <div class="site-header__inner">
    <a class="site-brand" href="/">
      {isArticle ? 'Dipanjan’s working notes' : 'Dipanjan Mondal'}
    </a>
    {!isArticle && <p class="site-statement">An editable record of what I understand.</p>}
    <nav class="site-nav" aria-label="Primary navigation">
      {
        sharedNav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="site-nav-menu">
      <summary aria-label="Navigation menu">Menu</summary>
      <nav aria-label="Compact navigation">
        {
          sharedNav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
    <ReadingPreferences />
  </div>
</header>
