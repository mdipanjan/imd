---
const nav = [
  { href: '/', label: 'Index' },
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href) && href !== '/rss.xml';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Dipanjan Mondal — thoughts, home">
      <span class="site-brand__mark" aria-hidden="true">DM</span>
      <span class="site-brand__text">
        <strong>Dipanjan Mondal</strong>
        <span>notes from the workbench</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
