---
type Props = {
  annotations: Array<{
    anchor: string;
    label: string;
    body: string;
  }>;
};

const { annotations } = Astro.props;
---

<aside class="annotation-rail" aria-label="Article annotations" aria-live="polite">
  <ol>
    {
      annotations.map((annotation) => (
        <li
          id={`annotation-${annotation.anchor}`}
          class="annotation-note"
          data-annotation-note={annotation.anchor}
        >
          <p class="annotation-note__body">
            <span>{annotation.label}</span>
            {annotation.body}
          </p>
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .annotation-rail {
    position: relative;
    padding: 8rem var(--space-5) var(--space-7);
    border-left: var(--border-thin) solid transparent;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .annotation-rail.has-active {
    border-color: var(--color-rule);
  }

  ol {
    position: absolute;
    top: var(--annotation-top, 8rem);
    right: var(--space-5);
    left: var(--space-5);
    display: grid;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: var(--space-4);
  }

  .annotation-note {
    transform: translateX(var(--space-2));
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility 0s linear var(--duration-fast);
  }

  .annotation-note.is-active {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  li::before {
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: var(--space-2);
    border-top: var(--border-emphasis) solid var(--color-revision);
    content: '';
  }

  .annotation-note__body {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }

  span {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-revision);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    text-transform: uppercase;
  }

  @media (max-width: 1000px) {
    .annotation-rail {
      position: fixed;
      z-index: 10;
      right: var(--space-4);
      bottom: var(--space-4);
      width: min(20rem, calc(100% - var(--space-6)));
      padding: var(--space-5);
      border: var(--border-thin) solid var(--color-rule);
      background: var(--color-surface);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--duration-fast) var(--ease-standard),
        visibility 0s linear var(--duration-fast);
    }

    .annotation-rail.has-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    ol {
      position: static;
    }
  }
</style>
