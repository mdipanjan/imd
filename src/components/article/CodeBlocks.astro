<style is:global>
  .article-prose .code-frame {
    overflow: hidden;
    margin-block: var(--space-6);
    border: var(--border-thin) solid var(--color-rule);
    background: color-mix(in srgb, var(--color-code-surface) 45%, var(--color-surface));
    border-radius: 3px;
  }

  .article-prose .code-frame__toolbar {
    display: flex;
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-faint);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
  }

  .article-prose .code-frame__copy {
    min-height: 44px;
    min-width: 44px;
    padding: 0.25rem 0;
    text-align: right;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    cursor: pointer;
  }

  .article-prose .code-frame__copy:hover,
  .article-prose .code-frame__copy:focus-visible {
    color: var(--color-accent-hover);
  }

  .article-prose .code-frame__copy:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .article-prose .code-frame .example-number {
    color: var(--color-accent);
  }
  .article-prose .code-frame .example-string {
    color: var(--color-text-muted);
  }

  .article-prose .code-frame pre code {
    font-size: inherit;
  }

  .article-prose .code-frame pre {
    padding: 4px var(--space-4) var(--space-4);
    font-size: 0.84rem;
    line-height: 1.65;
    tab-size: 4;
    max-width: 100%;
    margin: 0;
    border: 0;
    background: transparent !important;
    color: var(--color-text);
  }
</style>

<script>
  const languageNames: Record<string, string> = {
    js: 'JavaScript',
    ts: 'TypeScript',
    txt: 'Example',
    text: 'Example',
  };

  const copyCode = async (text: string) => {
    await navigator.clipboard.writeText(text);
  };

  document.querySelectorAll<HTMLElement>('.article-prose pre[data-language]').forEach((pre) => {
    if (pre.parentElement?.classList.contains('code-frame')) return;

    const language = pre.dataset.language ?? 'text';
    // Keep pseudocode as text; distinguish literal values without assigning a language.
    if (language === 'text' || language === 'txt') {
      pre.querySelectorAll('.line').forEach((line) => {
        const text = line.textContent ?? '';
        const fragments: Node[] = [];
        let cursor = 0;
        for (const match of text.matchAll(/"[^"\n]*"|\b\d+(?:\.\d+)?\b/g)) {
          const start = match.index!;
          fragments.push(document.createTextNode(text.slice(cursor, start)));
          const token = document.createElement('span');
          token.className = match[0].startsWith('"') ? 'example-string' : 'example-number';
          token.textContent = match[0];
          fragments.push(token);
          cursor = start + match[0].length;
        }
        fragments.push(document.createTextNode(text.slice(cursor)));
        line.replaceChildren(...fragments);
      });
    }
    const frame = document.createElement('div');
    const toolbar = document.createElement('div');
    const label = document.createElement('span');
    const button = document.createElement('button');

    frame.className = 'code-frame';
    toolbar.className = 'code-frame__toolbar';
    label.textContent = languageNames[language] ?? language;
    button.className = 'code-frame__copy';
    button.type = 'button';
    button.dataset.copyCode = '';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', `Copy ${label.textContent} code`);
    button.setAttribute('aria-live', 'polite');

    pre.before(frame);
    toolbar.append(label, button);
    frame.append(toolbar, pre);

    button.addEventListener('click', async () => {
      try {
        await copyCode(pre.textContent ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }

      window.setTimeout(() => {
        button.textContent = 'Copy';
      }, 1600);
    });
  });
</script>
