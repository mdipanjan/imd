---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  variant?: 'rail' | 'disclosure';
};

const { headings, variant = 'rail' } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{
  variant === 'rail' ? (
    <aside class="article-index-rail">
      <div class="article-index-rail__sticky">
        <p>On this page</p>
        <nav aria-label="On this page">
          {sections.map((heading) => (
            <a data-section-link href={`#${heading.slug}`}>
              {heading.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  ) : (
    sections.length > 0 && (
      <details class="article-index-disclosure">
        <summary>
          <span>On this page</span>
          <span>{String(sections.length).padStart(2, '0')} sections</span>
        </summary>
        <nav aria-label="On this page">
          {sections.map((heading) => (
            <a data-section-link href={`#${heading.slug}`}>
              {heading.text}
            </a>
          ))}
        </nav>
      </details>
    )
  )
}

<style>
  .article-index-rail {
    font-family: var(--font-sidebar);
    padding: var(--space-7) var(--space-5);
    border-right: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
  }

  .article-index-rail__sticky {
    position: sticky;
    top: var(--space-6);
  }

  .article-index-rail p {
    margin: 0 0 var(--space-5);
    color: var(--color-accent);
    font-family: var(--font-sidebar);
    font-size: var(--font-size-label);
    letter-spacing: 0.04em;
  }

  nav {
    display: grid;
    gap: var(--space-3);
  }

  nav a {
    position: relative;
    color: var(--color-text-muted);
    font-family: var(--font-sidebar);
    font-size: var(--font-size-label);
    line-height: 1.45;
    text-decoration: none;
  }

  nav a[aria-current='location'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  nav a[aria-current='location']::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 0.2em;
    bottom: 0.2em;
    width: 2px;
    background: currentColor;
  }
  nav a:hover {
    color: var(--color-accent);
  }

  .article-index-disclosure {
    display: none;
    margin: var(--space-5) 0 0;
    border-block: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
    font-family: var(--font-sidebar);
    font-size: var(--font-size-label);
  }

  .article-index-disclosure summary {
    display: flex;
    min-height: 2.75rem;
    padding-block: var(--space-3);
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .article-index-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .article-index-disclosure summary span:last-child {
    color: var(--color-text-faint);
  }

  .article-index-disclosure nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding-bottom: var(--space-3);
  }

  .article-index-disclosure nav a {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
  }

  @media (max-width: 900px) {
    .article-index-rail {
      display: none;
    }

    .article-index-disclosure {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .article-index-disclosure nav {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.article-prose h2[id]')];
  let scheduled = false;
  function updateSection() {
    scheduled = false;
    const threshold = Math.min(160, window.innerHeight * 0.25);
    let current = '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top > threshold) break;
      current = section.id;
    }
    for (const link of links) {
      if (link.hash === `#${current}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }
  function scheduleUpdate() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateSection);
  }
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  window.addEventListener('hashchange', scheduleUpdate);
  links.forEach((link) =>
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    }),
  );
  updateSection();
</script>
