---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  date: Date;
  context: string;
};

const { headings, date, context } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const formattedDate = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: '2-digit',
}).format(date);
---

<aside class="article-index-rail">
  <div class="article-index-rail__sticky">
    <p class="article-index-rail__date"><span>Published</span>{formattedDate}</p>
    <p class="article-index-rail__context"><span>Context</span>{context}</p>
    {
      sections.length > 0 && (
        <nav aria-label="On this page">
          {sections.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      )
    }
  </div>
</aside>

<style>
  .article-index-rail {
    padding: var(--space-7) var(--space-5);
    border-right: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
  }

  .article-index-rail__sticky {
    position: sticky;
    top: var(--space-6);
  }

  .article-index-rail__date,
  .article-index-rail__context {
    margin: 0;
    font-size: var(--font-size-small);
    line-height: 1.55;
  }

  .article-index-rail__date {
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    text-transform: uppercase;
  }

  p span {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-faint);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    font-style: normal;
    text-transform: uppercase;
  }

  .article-index-rail__context {
    margin-top: var(--space-7);
    color: var(--color-accent);
    font-style: italic;
  }

  nav {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  nav a {
    color: var(--color-text-muted);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    line-height: 1.45;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .article-index-rail {
      padding: var(--space-5) var(--page-gutter);
      border-right: 0;
      border-bottom: var(--border-thin) solid var(--color-rule);
    }

    .article-index-rail__sticky {
      position: static;
    }

    .article-index-rail__context {
      margin-top: var(--space-5);
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      margin-top: var(--space-5);
    }
  }
</style>
