---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  variant?: 'rail' | 'disclosure';
};

const { headings, variant = 'rail' } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{
  variant === 'rail' ? (
    <aside class="article-index-rail">
      <div class="article-index-rail__sticky">
        <p>On this page</p>
        <nav aria-label="On this page">
          {sections.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </div>
    </aside>
  ) : (
    sections.length > 0 && (
      <details class="article-index-disclosure">
        <summary>
          <span>On this page</span>
          <span>{String(sections.length).padStart(2, '0')} sections</span>
        </summary>
        <nav aria-label="On this page">
          {sections.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </details>
    )
  )
}

<style>
  .article-index-rail {
    padding: var(--space-7) var(--space-5);
    border-right: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
  }

  .article-index-rail__sticky {
    position: sticky;
    top: var(--space-6);
  }

  .article-index-rail p {
    margin: 0 0 var(--space-5);
    color: var(--color-accent);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  nav {
    display: grid;
    gap: var(--space-3);
  }

  nav a {
    color: var(--color-text-muted);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    line-height: 1.45;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .article-index-disclosure {
    display: none;
    margin: var(--space-5) 0 0;
    border-block: var(--border-thin) solid var(--color-rule);
    color: var(--color-text-muted);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
  }

  .article-index-disclosure summary {
    display: flex;
    min-height: 2.75rem;
    padding-block: var(--space-3);
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .article-index-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .article-index-disclosure summary span:last-child {
    color: var(--color-text-faint);
  }

  .article-index-disclosure nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding-bottom: var(--space-3);
  }

  .article-index-disclosure nav a {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
  }

  @media (max-width: 900px) {
    .article-index-rail {
      display: none;
    }

    .article-index-disclosure {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .article-index-disclosure nav {
      grid-template-columns: 1fr;
    }
  }
</style>
