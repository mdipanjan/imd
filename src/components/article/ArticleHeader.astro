---
import MetadataList from '../MetadataList.astro';
import { formatLongDate, formatTaxonomy } from '../../lib/format';

type Props = {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  draft?: boolean;
};

const { title, description, date, updated, tags, draft = false } = Astro.props;
const runningLabel = tags.map(formatTaxonomy).join(' / ');
const displayDate = updated ?? date;
const metadataItems = [
  {
    label: draft ? 'Draft updated' : updated ? 'Updated' : 'Published',
    value: formatLongDate(displayDate),
    datetime: displayDate.toISOString(),
  },
];
---

<header class="article-header">
  <p class="article-header__running">{runningLabel}</p>
  <h1>{title}</h1>
  <p class="article-header__deck">{description}</p>
  <MetadataList items={metadataItems} compact />
</header>

<style>
  .article-header {
    max-width: var(--width-prose);
    margin-inline: auto;
    padding-bottom: 0;
  }

  .article-header__running {
    margin: 0 0 var(--space-5);
    color: var(--color-text-faint);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    letter-spacing: 0.04em;
  }

  h1 {
    max-width: 22ch;
    text-wrap: balance;
    margin: 0;
    font-size: clamp(1.9rem, 2.7vw, 2.45rem);
    font-weight: var(--weight-regular);
    letter-spacing: -0.045em;
  }

  .article-header__deck {
    max-width: 40rem;
    margin: var(--space-4) 0 var(--space-5);
    color: var(--color-text-muted);
    font-size: 0.96rem;
    font-style: italic;
    line-height: 1.55;
  }
</style>
