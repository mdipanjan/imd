---
type Props = {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
};

const { title, description, date, updated, tags } = Astro.props;
const formatDate = (value: Date) =>
  new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'long',
    day: '2-digit',
  }).format(value);
---

<header class="article-header">
  <p class="article-header__running">
    {tags[0] ?? 'Field note'} · working note{updated ? ' · revised' : ''}
  </p>
  <h1>{title}</h1>
  <p class="article-header__deck">{description}</p>
  <dl class="article-header__meta">
    <div>
      <dt>Published</dt>
      <dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
    </div>
    {
      updated && (
        <div>
          <dt>Updated</dt>
          <dd>{formatDate(updated)}</dd>
        </div>
      )
    }
    <div>
      <dt>Status</dt>
      <dd>{updated ? 'Revised' : 'First revision'}</dd>
    </div>
    {
      tags.length > 0 && (
        <div>
          <dt>Filed under</dt>
          <dd>{tags.join(' / ')}</dd>
        </div>
      )
    }
  </dl>
</header>

<style>
  .article-header {
    max-width: var(--width-prose);
    margin-inline: auto;
    padding-bottom: var(--space-5);
  }

  .article-header__running {
    margin: 0 0 var(--space-5);
    color: var(--color-text-faint);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(1.9rem, 2.7vw, 2.45rem);
    font-weight: var(--weight-regular);
    letter-spacing: -0.045em;
  }

  .article-header__deck {
    max-width: 40rem;
    margin: var(--space-4) 0 var(--space-5);
    color: var(--color-text-muted);
    font-size: 0.96rem;
    font-style: italic;
    line-height: 1.55;
  }

  .article-header__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4) 0;
    border-block: var(--border-thin) solid var(--color-rule);
    font-family: var(--font-interface);
    font-size: var(--font-size-label);
  }

  .article-header__meta div {
    display: grid;
    gap: 0.2rem;
  }

  .article-header__meta dt,
  .article-header__meta dd {
    margin: 0;
  }

  .article-header__meta dt {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }

  .article-header__meta dd {
    color: var(--color-text-muted);
    text-transform: none;
  }
</style>
