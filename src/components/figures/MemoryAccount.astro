<figure class="memory-account" data-memory-account>
  <div class="scene technical-figure-scene">
    <div class="request-lane" data-request-lane>
      <span>deposit request</span><span>account 101</span>
    </div>
    <div class="deposit-packet" data-packet hidden aria-hidden="true">+ ₹1,000</div>
    <div class="ram-label">RAM <span>logical view</span></div>
    <div class="ram">
      <aside class="other-memory" aria-hidden="true">
        <span>other memory use</span>
        <div>system</div><div>other processes</div><div class="unused"></div>
      </aside>
      <div class="process">
        <div class="process-heading">Our service <span data-process>running</span></div>
        <div class="map-heading">accounts <span>in-memory map</span></div>
        <div class="map">
          <div class="record" data-record>
            <div class="key"><span>key</span><strong>101</strong></div>
            <svg class="connector" viewBox="0 0 60 30" aria-hidden="true"
              ><path d="M2 15H56m-6-5 6 5-6 5"></path></svg
            >
            <div class="value">
              <span>value</span><div>
                <strong>Maya Sen</strong><strong data-balance>5000</strong>
              </div>
            </div>
          </div>
          <div class="empty" aria-hidden="true" data-empty>
            <strong>accounts = {'{}'}</strong><span>no account records</span>
          </div>
        </div>
        <div class="process-note">only in the running process</div>
      </div>
    </div>
    <div class="controls" hidden data-controls>
      <button type="button" data-play aria-pressed="false">Play</button>
    </div>
    <p class="outcome" role="status" aria-live="polite" data-outcome>
      Account 101 has a balance of ₹5,000.
    </p>
  </div>
  <figcaption>
    Make a deposit, then restart the process. The map holds the balance only while the process is
    running. Play follows the sequence; Pause holds the current moment.
  </figcaption>
  <noscript
    ><p>
      Depositing ₹1,000 changes the balance to ₹6,000. Restarting the process clears the map and
      loses the account.
    </p></noscript
  >
</figure>

<script>
  import { reserveSpace } from './figure-space.mjs';
  import { bindPlayback } from './figure-playback.mjs';
  import { createMotionPlayer } from './figure-motion.mjs';
  import { initialBalance, updateAccount } from './memory-account.mjs';
  document.querySelectorAll<HTMLElement>('[data-memory-account]').forEach((figure) => {
    if (figure.dataset.ready) return;
    figure.dataset.ready = 'true';
    const value = figure.querySelector<HTMLElement>('[data-balance]')!;
    const record = figure.querySelector<HTMLElement>('[data-record]')!;
    const empty = figure.querySelector<HTMLElement>('[data-empty]')!;
    const status = figure.querySelector<HTMLElement>('[data-outcome]')!;
    const process = figure.querySelector<HTMLElement>('[data-process]')!;
    const packet = figure.querySelector<HTMLElement>('[data-packet]')!;
    const lane = figure.querySelector<HTMLElement>('[data-request-lane]')!;
    const scene = figure.querySelector<HTMLElement>('.scene')!;
    const animate = createMotionPlayer(matchMedia('(prefers-reduced-motion: reduce)'));
    let balance: number | null = initialBalance;
    function restore() {
      balance = initialBalance;
      value.textContent = String(balance);
      figure.classList.remove('is-empty', 'depositing', 'restarting');
      record.setAttribute('aria-hidden', 'false');
      empty.setAttribute('aria-hidden', 'true');
      process.textContent = 'running';
      status.textContent = 'Account 101 starts with ₹5,000.';
    }
    async function makeDeposit() {
      if (balance === null) return false;
      status.textContent = 'A ₹1,000 deposit is on its way to account 101.';
      const root = scene.getBoundingClientRect(),
        start = lane.getBoundingClientRect(),
        end = value.getBoundingClientRect();
      packet.hidden = false;
      const width = packet.getBoundingClientRect().width;
      const x = start.left - root.left,
        y = start.top - root.top + 6;
      packet.style.left = `${x}px`;
      packet.style.top = `${y}px`;
      const dx = end.left - root.left - width / 2 - x,
        dy = end.top - root.top - 14 - y;
      const landed = await animate(
        packet,
        [
          { opacity: 0, transform: 'translate(0,0)' },
          { opacity: 1, transform: 'translate(0,0)', offset: 0.18 },
          { opacity: 1, transform: `translate(${dx}px,${dy}px)`, offset: 0.85 },
          { opacity: 0, transform: `translate(${dx}px,${dy}px)` },
        ],
        1100,
      );
      packet.hidden = true;
      if (!landed) return false;
      balance = updateAccount(balance, 'deposit');
      value.textContent = String(balance);
      figure.classList.add('depositing');
      status.textContent = `Deposit applied. Account 101 now holds ₹${balance!.toLocaleString('en-IN')}.`;
      await animate(
        value,
        [
          { opacity: 0.35, transform: 'translateY(5px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ],
        300,
      );
      figure.classList.remove('depositing');
      return true;
    }
    async function restartProcess() {
      process.textContent = 'stopping';
      status.textContent = 'The process stops. Its account map is released.';
      const cleared = await animate(
        record,
        [
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(14px)' },
        ],
        650,
      );
      if (!cleared) return false;
      balance = null;
      figure.classList.add('is-empty', 'restarting');
      record.setAttribute('aria-hidden', 'true');
      empty.setAttribute('aria-hidden', 'false');
      process.textContent = 'starting';
      await animate(status, [{ opacity: 1 }, { opacity: 1 }], 550, false);
      figure.classList.remove('restarting');
      process.textContent = 'running again';
      status.textContent = 'Account 101 is gone. The new process started with an empty map.';
      return true;
    }
    reserveSpace(status, [
      'Account 101 has a balance of ₹5,000.',
      'A ₹1,000 deposit is on its way to account 101.',
      'Deposit applied. Account 101 now holds ₹6,000.',
      'The process stops. Its account map is released.',
      'Account 101 is gone. The new process started with an empty map.',
    ]);
    bindPlayback(figure, [makeDeposit, restartProcess], restore);
  });
</script>

<style>
  .scene {
    position: relative;
  }
  .request-lane {
    display: flex;
    gap: 16px;
    min-height: 42px;
    margin-bottom: 18px;
    color: var(--memory-muted);
    font:
      12px Menlo,
      monospace;
  }
  .request-lane span:last-child {
    opacity: 0.7;
  }
  .deposit-packet {
    position: absolute;
    z-index: 5;
    padding: 9px 12px;
    border: 1px solid var(--memory-accent);
    background: #34473b;
    color: var(--memory-ink);
    font:
      13px Menlo,
      monospace;
    pointer-events: none;
  }
  .deposit-packet[hidden] {
    display: none;
  }
  button[aria-pressed='true'] {
    border-color: var(--memory-accent);
    color: var(--memory-accent);
  }

  .memory-account {
    margin: var(--space-7) 0;
  }
  .scene {
    font-size: 14px;
  }
  .ram-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 15px;
  }
  .ram-label span,
  .process-note,
  .map-heading span {
    color: var(--memory-muted);
    font-size: 12px;
  }
  .ram {
    display: flex;
    gap: 20px;
    padding: 20px;
    border: 1px solid var(--memory-rule);
    border-radius: 5px;
  }
  .other-memory {
    flex: 0 0 115px;
    color: var(--memory-muted);
    font-size: 11px;
  }
  .other-memory div {
    padding: 12px 9px;
    margin-top: 10px;
    background: var(--memory-surface);
    border-radius: 3px;
  }
  .other-memory .unused {
    height: 40px;
    opacity: 0.35;
  }
  .process {
    flex: 1;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--memory-rule);
    border-radius: 4px;
    background: #242e2b;
    transition: opacity 300ms;
  }
  .process-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--memory-rule);
  }
  .process-heading span {
    color: var(--memory-muted);
    font-size: 12px;
  }
  .map-heading {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    font-family: Menlo, monospace;
  }
  .map {
    position: relative;
    margin-block: 22px;
  }
  .record {
    display: flex;
    align-items: end;
    transition:
      opacity 350ms,
      transform 350ms;
  }
  .key,
  .value {
    background: var(--memory-surface);
    border: 1px solid var(--memory-rule);
    border-radius: 3px;
    padding: 10px;
  }
  .key {
    flex: 0 0 50px;
  }
  .value {
    flex: 1;
    min-width: 0;
    transition:
      border-color 350ms,
      background 350ms;
  }
  .key > span,
  .value > span {
    display: block;
    color: var(--memory-muted);
    font-size: 11px;
    margin-bottom: 10px;
  }
  .value > div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  strong {
    font:
      13px Menlo,
      monospace;
  }
  .key strong {
    color: var(--memory-accent);
  }
  .connector {
    flex: 0 0 34px;
    width: 34px;
    height: 30px;
    margin-bottom: 6px;
    fill: none;
    stroke: var(--memory-accent);
    stroke-width: 1.3;
  }
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px dashed var(--memory-rule);
    opacity: 0;
    transition: opacity 350ms;
  }
  .empty span {
    color: var(--memory-muted);
    font-size: 12px;
  }
  .is-empty .record {
    opacity: 0;
    transform: translateY(6px);
  }
  .is-empty .empty {
    opacity: 1;
    transition-delay: 200ms;
  }
  .restarting .process {
    opacity: 0.45;
  }
  .depositing .value {
    border-color: var(--memory-accent);
    background: #34453d;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .controls[hidden] {
    display: none;
  }
  button {
    min-height: 44px;
    padding: 9px 12px;
    border: 1px solid var(--memory-rule);
    border-radius: 3px;
    background: transparent;
    color: var(--memory-ink);
    font:
      12px Menlo,
      monospace;
    cursor: pointer;
  }
  button:first-child {
    color: var(--memory-accent);
    border-color: var(--memory-accent);
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  button:hover:not(:disabled) {
    background: var(--memory-surface);
  }
  button:focus-visible {
    outline: 2px solid var(--memory-accent);
    outline-offset: 3px;
  }
  .outcome {
    min-height: 2.8em;
    margin: 16px 0 0;
    color: var(--memory-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: 0.85em;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  @media (max-width: 700px) {
    .other-memory {
      display: none;
    }
    .ram {
      padding: 12px;
    }
    .process {
      padding: 12px;
    }
  }
  @media (max-width: 400px) {
    .scene {
      padding: 12px;
    }
    .key {
      flex-basis: 42px;
    }
    .connector {
      flex-basis: 24px;
      width: 24px;
    }
  }

  /* Keep labels front-facing while exposing shallow top and side planes. */
  .ram {
    position: relative;
    margin: 10px 10px 0 0;
    border-radius: 1px;
    background: #232e29;
    box-shadow:
      9px 13px 0 #18211e,
      14px 22px 22px #10191645;
  }
  .ram::before {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: -11px;
    height: 10px;
    background: #35463e;
    border: 1px solid #61776b;
    transform: skewX(-42deg);
    transform-origin: bottom left;
  }
  .ram::after {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    right: -11px;
    width: 10px;
    background: #1b2521;
    border: 1px solid var(--memory-rule);
    transform: skewY(-48deg);
    transform-origin: top left;
  }
  .ram-label {
    margin-bottom: 22px;
  }
  .process {
    margin: 8px 4px 6px 0;
    position: relative;
    border-radius: 1px;
    background: #2b3931;
    box-shadow: 4px 6px 0 #17241c;
  }
  .process::before {
    content: '';
    position: absolute;
    top: -6px;
    height: 5px;
    left: -1px;
    right: -1px;
    background: #415448;
    border: 1px solid var(--memory-rule);
    transform: skewX(-42deg);
    transform-origin: bottom left;
  }
  .process::after {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    right: -6px;
    width: 5px;
    background: #1c2a21;
    border: 1px solid var(--memory-rule);
    transform: skewY(-48deg);
    transform-origin: top left;
  }
  .key,
  .value {
    border-radius: 1px;
    background: #34473b;
    box-shadow: none;
  }
  .other-memory div {
    border: 1px solid #3a4b41;
    border-radius: 1px;
    box-shadow: none;
  }
  .empty {
    background: #202d25;
    box-shadow: none;
  }
  .controls {
    margin-top: 32px;
  }
  .depositing .value {
    background: #425b4b;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }
</style>
