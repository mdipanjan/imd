---
type Props = { src: string; alt: string; caption: string };
const { src, alt, caption } = Astro.props;
---

<figure class="story-figure">
  <div class="figure-viewport" tabindex="0" role="region" aria-label={alt}>
    <a href={src} target="_blank" rel="noopener" aria-label={`Open full-size figure: ${alt}`}>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </a>
  </div>
  <span class="mobile-hint">Scroll across the figure. Tap to open full size.</span>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .story-figure {
    margin: var(--space-7) 0;
  }
  .figure-viewport {
    overflow-x: auto;
  }
  .mobile-hint {
    display: none;
  }
  .figure-viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  @media (max-width: 620px) {
    .story-figure a {
      min-width: 720px;
    }
    .mobile-hint {
      display: block;
      margin-top: var(--space-2);
      font-size: 0.75em;
      color: var(--color-text-muted);
    }
  }
  .story-figure a {
    display: block;
    border: var(--border-thin) solid var(--color-rule);
  }
  .story-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .story-figure a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  figcaption {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.85em;
    line-height: 1.6;
  }
</style>
