---
import { getStory } from './storage-stories.mjs';
type Props = { story: string };
const { story: id } = Astro.props;
const story: {
  title: string;
  caption: string;
  steps: {
    message: string;
    panes: { id: string; title: string; kind: string; rows: string[]; note: string }[];
  }[];
} = getStory(id);
---

<figure class="storage-story" data-storage-story={id} data-story={JSON.stringify(story)}>
  <div class="scene technical-figure-scene">
    <div class="stage" data-stage aria-label={story.title}>
      {
        story.steps[0].panes.map((pane) => (
          <div class:list={['pane', pane.kind]} data-pane={pane.id}>
            <div class="pane-title">{pane.title}</div>
            <div class="pane-rows" data-rows>
              {pane.rows.length ? (
                pane.rows.map((row) => <div class="data-row">{row}</div>)
              ) : (
                <div class="empty-row">empty</div>
              )}
            </div>
            <div class="pane-note">{pane.note}</div>
          </div>
        ))
      }
      <div class="transfer" data-transfer hidden aria-hidden="true"></div>
    </div>
    <div class="controls" data-controls hidden>
      <button type="button" data-play aria-pressed="false">Play</button>
    </div>
    <p class="status" role="status" aria-live="polite" data-status>{story.steps[0].message}</p>
  </div>
  <figcaption>{story.caption}</figcaption>
  <noscript><ol>{story.steps.map((step) => <li>{step.message}</li>)}</ol></noscript>
</figure>
<script>
  import { reserveSpace } from './figure-space.mjs';
  import { bindPlayback } from './figure-playback.mjs';
  import { createMotionPlayer } from './figure-motion.mjs';
  type Pane = { id: string; title: string; kind: string; rows: string[]; note: string };
  type Step = {
    message: string;
    panes: Pane[];
    transfer: null | { from: string | null; row: number; to: string; label: string };
  };
  type Story = { title: string; steps: Step[] };
  document.querySelectorAll<HTMLElement>('[data-storage-story]').forEach((figure) => {
    if (figure.dataset.ready) return;
    figure.dataset.ready = 'true';
    const story: Story = JSON.parse(figure.dataset.story!);
    const stage = figure.querySelector<HTMLElement>('[data-stage]')!;
    const transfer = figure.querySelector<HTMLElement>('[data-transfer]')!;
    const status = figure.querySelector<HTMLElement>('[data-status]')!;
    const play = createMotionPlayer(matchMedia('(prefers-reduced-motion: reduce)'));
    let current = 0;
    function render() {
      const step = story.steps[current];
      for (const pane of step.panes) {
        const target = stage.querySelector<HTMLElement>(`[data-pane="${pane.id}"]`)!;
        const rows = target.querySelector<HTMLElement>('[data-rows]')!;
        rows.replaceChildren(
          ...(pane.rows.length ? pane.rows : ['empty']).map((value) => {
            const row = document.createElement('div');
            row.className = pane.rows.length ? 'data-row' : 'empty-row';
            row.textContent = value;
            return row;
          }),
        );
        target.querySelector<HTMLElement>('.pane-note')!.textContent = pane.note;
        target.classList.toggle('is-target', step.transfer?.to === pane.id);
      }
      status.textContent = step.message;
    }
    async function advance() {
      if (current === story.steps.length - 1) return false;
      const step = story.steps[current + 1];
      if (step.transfer) {
        const t = step.transfer;
        const source = t.from
          ? (stage.querySelector<HTMLElement>(`[data-pane="${t.from}"] [data-rows]`)!.children[
              t.row
            ] as HTMLElement)
          : undefined;
        const destination = stage.querySelector<HTMLElement>(`[data-pane="${t.to}"] [data-rows]`)!;
        const base = stage.getBoundingClientRect(),
          end = destination.getBoundingClientRect(),
          start = source?.getBoundingClientRect();
        transfer.textContent = t.label;
        transfer.hidden = false;
        const box = transfer.getBoundingClientRect();
        const x = start ? start.left - base.left : Math.max(0, end.left - base.left),
          y = start ? start.top - base.top : 0;
        transfer.style.left = `${x}px`;
        transfer.style.top = `${y}px`;
        const dx = end.left - base.left - x,
          dy = end.top - base.top + Math.max(0, end.height - box.height) - y;
        const copied = await play(
          transfer,
          [
            { opacity: 0, transform: 'translate(0,0)' },
            { opacity: 1, transform: 'translate(0,0)', offset: 0.15 },
            { opacity: 1, transform: `translate(${dx}px,${dy}px)`, offset: 0.9 },
            { opacity: 0, transform: `translate(${dx}px,${dy}px)` },
          ],
          950,
        );
        if (!copied) return false;
        transfer.hidden = true;
      } else {
        const old = story.steps[current];
        for (const pane of step.panes) {
          const prior = old.panes.find((p) => p.id === pane.id)!;
          if (prior.rows.length && !pane.rows.length) {
            const rows = stage.querySelector<HTMLElement>(`[data-pane="${pane.id}"] [data-rows]`)!;
            if (
              !(await play(
                rows,
                [{ opacity: 1 }, { opacity: 0, transform: 'translateY(10px)' }],
                450,
              ))
            )
              return false;
          }
        }
      }
      current++;
      render();
      return true;
    }
    for (const pane of story.steps[0].panes) {
      const states = story.steps.map((step) => step.panes.find((item) => item.id === pane.id)!);
      const target = stage.querySelector<HTMLElement>(`[data-pane="${pane.id}"]`)!;
      reserveSpace(
        target.querySelector('[data-rows]')!,
        states,
        (probe: HTMLElement, value: Pane) => {
          probe.replaceChildren(
            ...(value.rows.length ? value.rows : ['empty']).map((text) => {
              const row = document.createElement('div');
              row.className = value.rows.length ? 'data-row' : 'empty-row';
              row.textContent = text;
              return row;
            }),
          );
        },
      );
      reserveSpace(
        target.querySelector('.pane-note')!,
        states.map((value) => value.note),
      );
    }
    reserveSpace(
      status,
      story.steps.map((step) => step.message),
    );
    bindPlayback(
      figure,
      story.steps.slice(1).map(() => advance),
      () => {
        current = 0;
        render();
      },
    );
  });
</script>
<style>
  .storage-story {
    margin: var(--space-7) 0;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 26px;
    padding: 12px 10px 14px 0;
    align-items: start;
  }
  .pane {
    position: relative;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--rule);
    background: #26342c;
  }
  .file,
  .table,
  .manifest {
    box-shadow: 5px 7px 0 #18231d;
  }
  .file::before,
  .table::before,
  .manifest::before {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: -7px;
    height: 6px;
    background: #35463e;
    border: 1px solid var(--rule);
    transform: skewX(-42deg);
    transform-origin: bottom left;
  }
  .file::after,
  .table::after,
  .manifest::after {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    right: -7px;
    width: 6px;
    background: #1b2521;
    border: 1px solid var(--rule);
    transform: skewY(-48deg);
    transform-origin: top left;
  }
  .memory {
    border-radius: 4px;
    background: #2c3b33;
    border-style: dashed;
  }
  .result {
    border: 0;
    background: transparent;
  }
  .pane-title {
    font:
      13px Menlo,
      monospace;
    margin-bottom: 16px;
  }
  .pane-rows {
    min-height: 44px;
  }
  .pane-rows :global(.data-row) {
    padding: 10px 0;
    border-bottom: 1px solid #45594e;
    font:
      11px Menlo,
      monospace;
    overflow-wrap: anywhere;
  }
  .table .pane-rows {
    border: 1px solid var(--rule);
    padding-inline: 8px;
  }
  .pane-rows :global(.empty-row) {
    padding: 12px 0;
    color: var(--muted);
    font:
      11px Menlo,
      monospace;
  }
  .pane-note {
    min-height: 2.8em;
    margin-top: 14px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }
  .is-target {
    border-color: var(--accent);
  }
  .is-target .pane-note {
    color: var(--accent);
  }
  .transfer {
    position: absolute;
    z-index: 5;
    background: #3a5044;
    border: 1px solid var(--accent);
    padding: 10px;
    font:
      11px Menlo,
      monospace;
    pointer-events: none;
    max-width: 90%;
  }
  .transfer[hidden] {
    display: none;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .controls[hidden] {
    display: none;
  }
  button {
    min-height: 44px;
    padding: 9px 12px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font:
      12px Menlo,
      monospace;
    cursor: pointer;
  }
  button:first-child,
  button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  button:hover:not(:disabled) {
    background: #293332;
  }
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .status {
    min-height: 4.5em;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: 0.85em;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  @media (max-width: 520px) {
    .stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 14px;
    }
    .pane {
      padding: 10px;
    }
    .pane:nth-last-child(2):nth-child(odd) {
      grid-column: 1 / -1;
    }
    .pane-title {
      font-size: 11px;
      margin-bottom: 10px;
    }
    .pane-rows :global(.data-row) {
      font-size: 10px;
      padding-block: 8px;
    }
    .pane-note {
      min-height: 0;
    }
    .status {
      min-height: 0;
    }
  }
</style>
